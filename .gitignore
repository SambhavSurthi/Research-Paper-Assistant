# === Secrets and local environment ===
# Never commit real API keys or provider endpoints. Keep only the template.
.env
.env.*
!.env.example

# === Python bytecode, build, and packaging ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/

# === Virtual environments ===
.venv/
venv/
env/
ENV/

