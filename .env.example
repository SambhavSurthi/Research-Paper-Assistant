# AI Research Paper Assistant — environment variables
# Copy this file to `.env` and fill in the values you own.
# External/provider keys are intentionally left EMPTY here.

# OpenAI — LLM inference + text-embedding-3-small embeddings
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily — live web search used for "latest developments" and claim verification
# Get it from: https://tavily.com
TAVILY_API_KEY=

# Qdrant Cloud — vector store endpoint and API key
# Get both from: https://cloud.qdrant.io (cluster overview -> Endpoint / API Keys)
QDRANT_URL=
QDRANT_API_KEY=

# Neo4j (Docker local or Bolt/HTTP) — knowledge graph + embedded chunk store
# Start Neo4j via: docker compose up -d neo4j  (Browser UI: http://localhost:7476)
NEO4J_HTTP_URL=http://localhost:7476
NEO4J_URI=bolt://localhost:7689
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ai_research_paper_assistant_pass
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Optional (leave empty / commented unless you use these services)
# ---------------------------------------------------------------------------
# LangSmith tracing (the `langsmith` package is installed but not required)
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=ai-research-paper-assistant
#
# DeepEval cloud dashboard for `evaluate.py` (local evaluation works without it)
# DEEPEVAL_API_KEY=
